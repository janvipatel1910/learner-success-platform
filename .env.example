# SkillPulse local development configuration
# Copy this file to .env and change local values as needed.
# Never use these example values in production.

POSTGRES_DB=skillpulse
POSTGRES_USER=skillpulse
POSTGRES_PASSWORD=change_me_for_local_development
POSTGRES_PORT=55432
POSTGRES_HOST=localhost
DATABASE_CONNECT_TIMEOUT_SECONDS=3

ENVIRONMENT=local
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]
