# ---------------------------------------------------------------------------
# Backend: one EC2 instance running the API and PostgreSQL in Docker.
# - No SSH: administration is through AWS Systems Manager Session Manager.
# - Port 8000 only accepts traffic from CloudFront's own IP ranges.
# - The database password is generated by Terraform and kept in SSM
#   Parameter Store as an encrypted SecureString, never in Git.
# ---------------------------------------------------------------------------

data "aws_vpc" "default" {
  default = true
}

data "aws_subnets" "default" {
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.default.id]
  }
  filter {
    name   = "default-for-az"
    values = ["true"]
  }
}

data "aws_ssm_parameter" "al2023_arm64" {
  name = "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-arm64"
}

data "aws_ec2_managed_prefix_list" "cloudfront_origin_facing" {
  name = "com.amazonaws.global.cloudfront.origin-facing"
}

resource "random_password" "postgres" {
  length  = 32
  special = false
}

resource "aws_ssm_parameter" "postgres_password" {
  name        = "/${var.project_name}/postgres-password"
  description = "PostgreSQL password for the SkillPulse API."
  type        = "SecureString"
  value       = random_password.postgres.result
}

resource "aws_security_group" "backend" {
  name        = "${var.project_name}-backend"
  description = "SkillPulse API: only CloudFront may reach port 8000"
  vpc_id      = data.aws_vpc.default.id

  ingress {
    description     = "API traffic from CloudFront only"
    from_port       = 8000
    to_port         = 8000
    protocol        = "tcp"
    prefix_list_ids = [data.aws_ec2_managed_prefix_list.cloudfront_origin_facing.id]
  }

  egress {
    description = "Outbound for updates, Docker images and AWS APIs"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

data "aws_iam_policy_document" "ec2_assume_role" {
  statement {
    actions = ["sts:AssumeRole"]
    principals {
      type        = "Service"
      identifiers = ["ec2.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "backend" {
  name               = "${var.project_name}-backend"
  assume_role_policy = data.aws_iam_policy_document.ec2_assume_role.json
}

resource "aws_iam_role_policy_attachment" "backend_ssm" {
  role       = aws_iam_role.backend.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
}

data "aws_iam_policy_document" "backend_read_secret" {
  statement {
    actions   = ["ssm:GetParameter"]
    resources = [aws_ssm_parameter.postgres_password.arn]
  }
}

resource "aws_iam_role_policy" "backend_read_secret" {
  name   = "read-postgres-password"
  role   = aws_iam_role.backend.id
  policy = data.aws_iam_policy_document.backend_read_secret.json
}

resource "aws_iam_instance_profile" "backend" {
  name = "${var.project_name}-backend"
  role = aws_iam_role.backend.name
}

resource "aws_instance" "backend" {
  ami                    = data.aws_ssm_parameter.al2023_arm64.value
  instance_type          = var.backend_instance_type
  subnet_id              = sort(data.aws_subnets.default.ids)[0]
  vpc_security_group_ids = [aws_security_group.backend.id]
  iam_instance_profile   = aws_iam_instance_profile.backend.name

  user_data = templatefile("${path.module}/user_data.sh.tftpl", {
    aws_region            = var.aws_region
    git_ref               = var.git_ref
    password_parameter    = aws_ssm_parameter.postgres_password.name
    cognito_user_pool_id  = var.cognito_user_pool_id
    cognito_app_client_id = var.cognito_app_client_id
  })
  user_data_replace_on_change = true

  metadata_options {
    http_tokens = "required" # IMDSv2 only
  }

  root_block_device {
    volume_type = "gp3"
    volume_size = 20
    encrypted   = true
  }

  tags = {
    Name = "${var.project_name}-backend"
  }

  lifecycle {
    ignore_changes = [ami] # do not rebuild the server every time AWS publishes a new AMI
  }
}

# A fixed public address, so CloudFront's origin stays valid across stop/start.
resource "aws_eip" "backend" {
  domain   = "vpc"
  instance = aws_instance.backend.id

  tags = {
    Name = "${var.project_name}-backend"
  }
}
